# Copie para .env (ou coloque no serviço do systemd) e ajuste.
# No Render nada disto é obrigatório (ver README). Numa VPS:
# Conexão com as partidas: enet (UDP direto) ou websocket (wss://<NEPHELIA_PUBLIC_URL>/play/<partida>).
NEPHELIA_TRANSPORT=enet
# NEPHELIA_PUBLIC_URL=wss://meu-servidor.example.com
# Porta HTTP do matchmaker (o jogo pede partida aqui).
NEPHELIA_HTTP_PORT=8080
# Endereço público que os jogadores usam para chegar nas partidas (IP ou domínio do servidor).
NEPHELIA_PUBLIC_HOST=127.0.0.1
# Executável do Godot (ou do servidor exportado) e os argumentos antes do "--".
NEPHELIA_GODOT_BIN=/opt/nephelia/godot
NEPHELIA_GODOT_ARGS=--headless --main-pack /opt/nephelia/nephelia_server.pck
# Portas UDP das partidas (liberar no firewall).
NEPHELIA_MATCH_PORT_FIRST=24700
NEPHELIA_MATCH_PORT_LAST=24719
NEPHELIA_MAX_MATCHES=8
NEPHELIA_WARM_MATCHES=1
# Versão do protocolo de rede do jogo (NetMessage.VERSION).
NEPHELIA_PROTOCOL_VERSION=1
